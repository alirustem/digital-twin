# Public Turnstile site key. Next inlines this into the static site at build time.
# It is not a secret. Never put the Turnstile secret key in this file.
#
# Local widget testing only. Do not build production with this test key:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
